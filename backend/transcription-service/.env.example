# APP Config
APP_PORT=3000
APP_ENV=development

# Postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=transcription_service_dev
POSTGRES_USER=myusername
POSTGRES_PASSWORD=mysecurepassword123

# Minio
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_admin
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=transcription-audio

# Faster Whisper API
FASTER_WHISPER_ENDPOINT=http://faster-whisper
FASTER_WHISPER_PORT=8000
FASTER_WHIPSER_MODEL=Systran/faster-whisper-small

# Settings
MAX_MB_FILE_SIZE=5
ALLOWED_FILE_TYPES=webm

# Frontend URL
FRONTEND_URL=http://frontend:8080