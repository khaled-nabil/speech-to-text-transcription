# APP Config
APP_PORT=3000
APP_ENV=development

# Postgres
POSTGRES_PORT=5432
POSTGRES_DB=transcription_service_dev
POSTGRES_USER=myusername
POSTGRES_PASSWORD=mysecurepassword123

# Minio
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_admin
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=transcription-audio

# Faster Whisper API
FASTER_WHISPER_ENDPOINT=localhost
FASTER_WHISPER_PORT=4000
FASTER_WHIPSER_MODEL=Systran/faster-whisper-small

# Settings
MAX_MB_FILE_SIZE=5
ALLOWED_FILE_TYPES=mp3,wav